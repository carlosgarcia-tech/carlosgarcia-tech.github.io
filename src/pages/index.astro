---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Stack from '../components/Stack.astro';
import Engineering from '../components/Engineering.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="Carlos García — Software Developer | Backend & DevOps">
  <Hero />

  <section class="section-spacing">
    <div class="container-narrow">
      <p class="text-text-secondary leading-relaxed max-w-2xl text-lg reveal">
        I'm a Software Developer focused on backend systems and the infrastructure that
        runs them. I like understanding how things work end-to-end — from writing the
        business logic to shipping it with zero-downtime deployments. Most of my work is
        in Node.js/TypeScript, with a growing focus on distributed systems and observability.
      </p>
    </div>
  </section>

  <Projects />
  <Engineering />
  <Stack />
  <Contact />
</Layout>
