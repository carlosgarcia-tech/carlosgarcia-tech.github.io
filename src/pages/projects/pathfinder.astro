---
import Layout from "../../layouts/Layout.astro";
import PathFinderDiagram from "../../components/diagrams/PathFinderDiagram.astro";
import PathFinderPreview from "../../components/previews/PathFinderPreview.astro";

const project = {
  title: "PathFinder",
  subtitle: "Pathfinding API",
  description:
    "A RESTful API for pathfinding with maps, waypoints, obstacles, and route optimization. Features JWT authentication, API key management, Redis caching, and role-based access control.",
  github: "https://github.com/carlosgarcia-tech/pathfinder",
  tags: ["Node.js 20+", "Express", "MongoDB", "Redis", "JWT", "Docker"],
};

const metrics = [
  { value: "JWT", label: "authentication", detail: "access + refresh tokens" },
  { value: "RBAC", label: "access control", detail: "Admin, Editor, Viewer" },
  { value: "Redis", label: "caching", detail: "route caching for performance" },
  { value: "26", label: "commits", detail: "on main branch" },
];

const features = [
  {
    title: "Maps Management",
    description:
      "Create and manage maps with waypoints and obstacles. Full CRUD operations with pagination.",
  },
  {
    title: "Pathfinding",
    description:
      "Find optimal routes using pathfinding algorithms. Route optimization for complex maps.",
  },
  {
    title: "Authentication & Authorization",
    description:
      "JWT-based authentication with access/refresh tokens. API keys for external access. Role-based access control (Admin, Editor, Viewer).",
  },
  {
    title: "Rate Limiting & Caching",
    description:
      "Redis-backed rate limiting with in-memory fallback. Route caching for performance optimization.",
  },
  {
    title: "Security",
    description:
      "Helmet for secure HTTP headers. Input sanitization (MongoDB injection & XSS prevention). CORS configuration.",
  },
];

const apiEndpoints = [
  {
    method: "POST",
    path: "/api/auth/register",
    description: "Register new user",
  },
  { method: "POST", path: "/api/auth/login", description: "Login" },
  { method: "POST", path: "/api/auth/refresh", description: "Refresh token" },
  { method: "GET", path: "/api/maps", description: "List maps (paginated)" },
  { method: "POST", path: "/api/maps", description: "Create map" },
  {
    method: "POST",
    path: "/api/routes/optimal",
    description: "Find optimal route",
  },
  { method: "GET", path: "/api/keys", description: "List API keys" },
  { method: "GET", path: "/api/analytics", description: "Get analytics data" },
];

const stack = [
  { layer: "Runtime", technology: "Node.js 20+" },
  { layer: "Framework", technology: "Express.js" },
  { layer: "Database", technology: "MongoDB with Mongoose" },
  { layer: "Cache", technology: "Redis" },
  { layer: "Auth", technology: "JWT" },
  { layer: "Testing", technology: "Jest" },
  { layer: "Containers", technology: "Docker multi-stage builds" },
];
---

<Layout title={`${project.title} — Carlos García`} ogImage="/og-pathfinder.png">
  <article class="section-spacing">
    <div class="container-narrow">
      <div class="mb-12 reveal">
        <a
          href="/"
          class="font-mono text-sm text-accent hover:text-accent-muted transition-colors duration-150 mb-4 inline-block"
        >
          ← Back to projects
        </a>
        <h1 class="text-display font-heading text-text-primary mb-2">
          {project.title}
        </h1>
        <p class="text-text-muted font-mono text-sm mb-6">{project.subtitle}</p>
        <p class="text-text-secondary text-lg leading-relaxed max-w-2xl">
          {project.description}
        </p>
      </div>

      <div
        class="flex flex-wrap items-center gap-4 mb-12 font-mono text-xs text-text-muted reveal reveal-delay-1"
      >
        <span class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald"></span>
          Active
        </span>
        <span>Started Aug 2024</span>
        <span>·</span>
        <span>26 commits</span>
        <span>·</span>
        <a
          href={`${project.github}/blob/main/README.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:text-accent-muted transition-colors duration-150"
        >
          View README ↗
        </a>
      </div>

      <div class="flex flex-wrap gap-2 mb-12 reveal reveal-delay-1">
        {project.tags.map((tag) => <span class="tech-badge">{tag}</span>)}
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
        {
          metrics.map((metric) => (
            <div class="metric-card reveal">
              <span class="metric-value count-up-value">{metric.value}</span>
              <p class="metric-label">{metric.label}</p>
              <p class="text-xs text-text-muted mt-0.5">{metric.detail}</p>
            </div>
          ))
        }
      </div>

      <section class="mb-16">
        <h2 class="text-headline font-heading text-text-primary mb-6 reveal">
          API Playground
        </h2>
        <div class="reveal reveal-delay-1">
          <PathFinderPreview />
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-headline font-heading text-text-primary mb-6 reveal">
          Request pipeline
        </h2>
        <div class="card-surface p-6 md:p-8 reveal reveal-delay-1">
          <PathFinderDiagram />
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-headline font-heading text-text-primary mb-6 reveal">
          Key decisions
        </h2>
        <div class="grid gap-4 stagger-children">
          <div class="card-surface card-hover p-6">
            <h3 class="font-heading font-semibold text-text-primary mb-2">
              A* with Euclidean heuristic
            </h3>
            <p class="text-text-secondary text-sm leading-relaxed">
              The pathfinding uses A* (A-star) with Euclidean distance as the
              heuristic — not Manhattan. Euclidean gives true straight-line
              distance, which pairs naturally with 16-directional movement and
              produces smoother, more natural routes than grid-constrained
              heuristics.
            </p>
          </div>
          <div class="card-surface card-hover p-6">
            <h3 class="font-heading font-semibold text-text-primary mb-2">
              16-directional movement
            </h3>
            <p class="text-text-secondary text-sm leading-relaxed">
              Beyond the standard 8 directions (cardinals + diagonals), the
              algorithm supports 4 additional knight-like moves (±2,±1). This
              wider neighborhood produces smoother paths with fewer unnecessary
              detours, at the cost of more neighbor evaluations per node.
            </p>
          </div>
          <div class="card-surface card-hover p-6">
            <h3 class="font-heading font-semibold text-text-primary mb-2">
              Terrain-aware cost model
            </h3>
            <p class="text-text-secondary text-sm leading-relaxed">
              Each cell has a terrain type (plains, road, forest, mountain,
              sand, swamp, water, wall) with a movement cost multiplier. Roads
              cost 0.8×, forests 1.5×, mountains 3×. Water and walls are
              impassable (Infinity). The total path cost reflects real traversal
              difficulty, not just hop count.
            </p>
          </div>
          <div class="card-surface card-hover p-6">
            <h3 class="font-heading font-semibold text-text-primary mb-2">
              Catmull-Rom path smoothing
            </h3>
            <p class="text-text-secondary text-sm leading-relaxed">
              Raw A* paths follow grid edges. Catmull-Rom spline interpolation
              smooths the path between waypoints while checking for obstacle
              collisions. If a smoothed segment clips an obstacle, it falls back
              to the original point — giving smooth curves without sacrificing
              collision safety.
            </p>
          </div>
          <div class="card-surface card-hover p-6">
            <h3 class="font-heading font-semibold text-text-primary mb-2">
              Waypoint ordering: Held-Karp vs 2-opt
            </h3>
            <p class="text-text-secondary text-sm leading-relaxed">
              For routes with multiple waypoints, the order matters. Under 10
              waypoints, Held-Karp (exact O(2ⁿ·n²)) finds the optimal visiting
              order. Above 10, 2-opt (heuristic) provides near-optimal ordering
              in reasonable time. This avoids the factorial explosion of
              brute-force permutation.
            </p>
          </div>
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-headline font-heading text-text-primary mb-6 reveal">
          Features
        </h2>
        <div class="grid gap-4 stagger-children">
          {
            features.map((feature) => (
              <div class="card-surface card-hover p-6">
                <h3 class="font-heading font-semibold text-text-primary mb-2">
                  {feature.title}
                </h3>
                <p class="text-text-secondary text-sm leading-relaxed">
                  {feature.description}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-headline font-heading text-text-primary mb-6 reveal">
          API endpoints
        </h2>
        <div class="card-surface p-6 md:p-8 reveal reveal-delay-1">
          <div class="grid gap-3">
            {
              apiEndpoints.map((item) => (
                <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-4 py-2 border-b border-surface-border last:border-0">
                  <span
                    class={`font-mono text-xs font-semibold px-2 py-0.5 rounded ${
                      item.method === "POST"
                        ? "bg-emerald/20 text-emerald"
                        : "bg-accent/20 text-accent"
                    }`}
                  >
                    {item.method}
                  </span>
                  <span class="font-mono text-sm text-text-primary">
                    {item.path}
                  </span>
                  <span class="text-text-muted text-sm">
                    {item.description}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-headline font-heading text-text-primary mb-6 reveal">
          Stack
        </h2>
        <div class="card-surface p-6 md:p-8 reveal reveal-delay-1">
          <div class="grid gap-3">
            {
              stack.map((item) => (
                <div class="flex items-center justify-between py-2 border-b border-surface-border last:border-0">
                  <span class="font-mono text-sm text-text-muted">
                    {item.layer}
                  </span>
                  <span class="text-text-primary text-sm font-medium">
                    {item.technology}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <div class="flex flex-wrap gap-4 reveal">
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 bg-accent text-white font-medium rounded-md hover:bg-accent-muted transition-colors duration-150"
        >
          View Source Code
        </a>
        <a
          href={`${project.github}/blob/main/README.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 border border-surface-border text-text-secondary font-medium rounded-md hover:border-text-muted hover:text-text-primary transition-colors duration-150"
        >
          Read README
        </a>
        <a
          href="/"
          class="inline-flex items-center px-6 py-3 border border-surface-border text-text-secondary font-medium rounded-md hover:border-text-muted hover:text-text-primary transition-colors duration-150"
        >
          Back to Projects
        </a>
      </div>
    </div>
  </article>
</Layout>
