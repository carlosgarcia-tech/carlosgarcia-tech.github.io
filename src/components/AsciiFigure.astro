---
import raw from "../../public/ascii-art.txt?raw";

const lines = raw
  .replace(/\r/g, "")
  .split("\n")
  .map((l) => l.replace(/\s+$/, ""));

while (lines.length && !lines[0].trim()) lines.shift();
while (lines.length && !lines[lines.length - 1].trim()) lines.pop();

const indent = Math.min(
  ...lines.filter((l) => l.trim()).map((l) => l.search(/\S/)),
);
const trimmed = lines.map((l) => l.slice(indent));

const cols = Math.max(...trimmed.map((l) => l.length));
const rows = trimmed.length;
const grid = trimmed.map((l) => l.padEnd(cols, " ").split(""));

// Densidad local: la figura es compacta, las estrellas están aisladas
const RY = 3;
const RX = 6;
const FIGURE_THRESHOLD = 0.18;

const density = (y: number, x: number) => {
  let filled = 0;
  let total = 0;
  for (let dy = -RY; dy <= RY; dy++) {
    const row = grid[y + dy];
    if (!row) continue;
    for (let dx = -RX; dx <= RX; dx++) {
      const ch = row[x + dx];
      if (ch === undefined) continue;
      total++;
      if (ch !== " ") filled++;
    }
  }
  return filled / total;
};

const HEAVY = new Set(["@", "%", "#", "*", "+"]);
const blank = () => grid.map((r) => r.map(() => " "));
const back = blank();
const mid = blank();
const front = blank();

for (let y = 0; y < rows; y++) {
  for (let x = 0; x < cols; x++) {
    const ch = grid[y][x];
    if (ch === " ") continue;
    if (density(y, x) < FIGURE_THRESHOLD) back[y][x] = ch;
    else if (HEAVY.has(ch)) front[y][x] = ch;
    else mid[y][x] = ch;
  }
}

const toText = (layer: string[][]) => layer.map((r) => r.join("")).join("\n");
---

<div class="ascii-wrap" data-ascii-3d style={`--cols:${cols}; --rows:${rows};`}>
  <div class="ascii-figure" data-scrub="draw" aria-hidden="true">
    <div class="ascii-scene">
      <div class="ascii-stage">
        <pre class="ascii-layer layer-back" style="--z:-90">{toText(back)}</pre>
        <pre class="ascii-layer layer-mid" style="--z:0">{toText(mid)}</pre>
        <pre
          class="ascii-layer layer-front"
          style="--z:12">{toText(front)}</pre>
      </div>
    </div>
  </div>
  <p class="sr-only">Ilustración ASCII</p>
</div>

<style>
  .ascii-wrap {
    width: 100%;
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    padding: 0.75rem 0.5rem;
    background: linear-gradient(
      170deg,
      rgba(255, 107, 28, 0.06) 0%,
      rgba(255, 107, 28, 0.02) 42%,
      rgba(255, 255, 255, 0.7) 100%
    );
    border: 1px solid rgba(20, 28, 38, 0.12);
    border-radius: 0.75rem;
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    backdrop-filter: blur(14px) saturate(170%);
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(0, 0, 0, 0.04),
      0 10px 26px -10px rgba(255, 107, 28, 0.25),
      0 0 0 1px rgba(255, 107, 28, 0.12);
  }

  /* El brillo sigue al puntero (--gx / --gy los escribe el script) */
  .ascii-wrap::before {
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 45%),
      rgba(255, 107, 28, 0.22),
      transparent 65%
    );
  }

  /* Perspectiva en el padre, preserve-3d en el escenario.
     El clip-path del scrub vive en .ascii-figure, un nivel más arriba,
     porque clip-path aplana el 3D de sus hijos directos. */
  .ascii-scene {
    perspective: 700px;
    perspective-origin: 50% 50%;
  }

  .ascii-stage {
    display: grid;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .ascii-layer {
    grid-area: 1 / 1;
    margin: 0;
    white-space: pre;
    user-select: none;
    font-family:
      ui-monospace, "SFMono-Regular", Menlo, Consolas, "Courier New", monospace;
    font-size: calc(100cqw / (var(--cols) * 0.6));
    line-height: 1.05;
    /* scale compensa la perspectiva: en reposo todas las capas miden lo mismo */
    transform: translateZ(calc(var(--z) * 1px))
      scale(calc((700 - var(--z)) / 700));
  }

  .layer-back {
    color: rgba(154, 52, 18, 0.65);
  }

  .layer-mid {
    color: rgba(15, 20, 25, 0.78);
  }

  .layer-front {
    color: rgba(15, 20, 25, 0.96);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip: rect(0, 0, 0, 0);
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp = (v: number, a: number, b: number) =>
    Math.min(b, Math.max(a, v));

  document.querySelectorAll<HTMLElement>("[data-ascii-3d]").forEach((wrap) => {
    const stage = wrap.querySelector<HTMLElement>(".ascii-stage");
    if (!stage || reduce) return;

    let px = 0;
    let py = 0;
    let cx = 0;
    let cy = 0;
    let raf = 0;

    window.addEventListener(
      "pointermove",
      (e) => {
        px = (e.clientX / window.innerWidth - 0.5) * 2;
        py = (e.clientY / window.innerHeight - 0.5) * 2;
      },
      { passive: true },
    );

    const tick = (t: number) => {
      const r = wrap.getBoundingClientRect();
      const scroll = clamp(
        (r.top + r.height / 2 - window.innerHeight / 2) / window.innerHeight,
        -1,
        1,
      );

      // Deriva lenta: se mueve aunque el mouse esté quieto
      const idleX = Math.sin(t / 2600) * 0.3;
      const idleY = Math.cos(t / 3400) * 0.2;

      cx += (px + idleX - cx) * 0.07;
      cy += (py + idleY - cy) * 0.07;

      const rotY = cx * 14 + scroll * 16;
      const rotX = -cy * 8 - scroll * 10;

      stage.style.transform = `rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg)`;
      wrap.style.setProperty("--gx", `${(50 + cx * 18).toFixed(1)}%`);
      wrap.style.setProperty("--gy", `${(45 + cy * 18).toFixed(1)}%`);

      raf = requestAnimationFrame(tick);
    };

    new IntersectionObserver(([entry]) => {
      cancelAnimationFrame(raf);
      if (entry.isIntersecting) raf = requestAnimationFrame(tick);
    }).observe(wrap);
  });
</script>
