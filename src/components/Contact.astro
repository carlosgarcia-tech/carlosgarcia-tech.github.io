---

<section id="contact" class="section-spacing border-t border-surface-border">
  <div class="container-narrow">
    <div class="max-w-xl reveal">
      <p class="font-mono text-sm text-accent mb-2">Get in touch</p>
      <h2 class="text-headline font-heading text-text-primary mb-4">Contact</h2>
      <p class="text-text-secondary mb-8">
        Interested in my work or want to discuss a project? The best way to reach me is through GitHub or email.
      </p>

      <div class="flex flex-col gap-4">
        <a
          href="https://github.com/carlosgarcia-tech"
          target="_blank"
          rel="noopener noreferrer"
          class="card-surface p-4 flex items-center justify-between group hover:border-accent/40 transition-all duration-150"
        >
          <div>
            <p class="font-heading font-semibold text-text-primary group-hover:text-accent transition-colors duration-150">
              GitHub
            </p>
            <p class="text-text-muted text-sm font-mono">carlosgarcia-tech</p>
          </div>
          <span class="text-text-muted group-hover:text-accent transition-colors duration-150">↗</span>
        </a>

        <a
          href="mailto:contact@carlosgarcia.dev"
          class="card-surface p-4 flex items-center justify-between group hover:border-accent/40 transition-all duration-150"
        >
          <div>
            <p class="font-heading font-semibold text-text-primary group-hover:text-accent transition-colors duration-150">
              Email
            </p>
            <p class="text-text-muted text-sm font-mono">contact@carlosgarcia.dev</p>
          </div>
          <span class="text-text-muted group-hover:text-accent transition-colors duration-150">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
