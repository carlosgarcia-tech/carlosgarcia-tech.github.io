---
import AsciiFigure from "./AsciiFigure.astro";

const metrics = [
  { value: "1010", label: "tests passing", delay: 4 },
  { value: "50+", label: "API endpoints", delay: 4 },
  { value: "200+", label: "commands", delay: 5 },
  { value: "50", label: "concurrent sessions", delay: 5 },
];
---

<section
  class="relative flex items-center overflow-hidden pt-32 pb-20 md:pt-40 md:pb-24"
>
  <div class="aurora-orb aurora-orb-blue" aria-hidden="true"></div>
  <div class="aurora-orb aurora-orb-cyan" aria-hidden="true"></div>
  <div
    class="absolute inset-0 grid-lines opacity-40"
    data-scrub="parallax"
    data-speed="0.06"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto w-full max-w-6xl px-6">
    <div
      class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-16"
    >
      <div class="min-w-0">
        <p class="reveal mb-4 font-mono text-sm tracking-wide text-accent">
          backend / devops / systems
        </p>

        <h1
          class="aurora-text mb-6 font-heading text-5xl font-bold leading-[1.05] tracking-tight md:text-6xl lg:text-7xl"
          data-scrub="parallax"
          data-speed="0.08"
        >
          Carlos García
        </h1>

        <p
          class="mb-8 max-w-xl text-lg leading-relaxed text-text-secondary md:text-xl"
          data-scrub="fade"
        >
          I build software systems and automate the infrastructure that runs
          them.
        </p>

        <div class="reveal reveal-delay-3 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            class="cta-glass pressable inline-flex items-center px-6 py-2.5 font-medium text-white transition-colors duration-150"
          >
            View Projects
          </a>
          <a
            href="https://github.com/carlosgarcia-tech"
            target="_blank"
            rel="noopener noreferrer"
            class="glass-chip glass-interactive rounded-full text-sm"
          >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/carlos-garcia-gg/"
            target="_blank"
            rel="noopener noreferrer"
            class="glass-chip glass-interactive rounded-full text-sm"
          >
            <svg
              class="shrink-0"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
              ></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
            LinkedIn
          </a>
          <a
            href="/cv-carlos-garcia.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="glass-chip glass-interactive rounded-full text-sm"
          >
            Download CV
          </a>
        </div>
      </div>

      <div class="hidden lg:block" data-scrub="parallax" data-speed="0.12">
        <AsciiFigure />
      </div>
    </div>

    <div class="mt-16 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {
        metrics.map((m) => (
          <div class={`metric-card reveal reveal-delay-${m.delay}`}>
            <span class="metric-value count-up-value">{m.value}</span>
            <p class="metric-label">{m.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
