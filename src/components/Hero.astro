---
import AsciiFigure from './AsciiFigure.astro';
---

<section class="relative min-h-[85vh] flex items-center section-spacing overflow-hidden">
  <div class="aurora-orb aurora-orb-blue" aria-hidden="true"></div>
  <div class="aurora-orb aurora-orb-cyan" aria-hidden="true"></div>
  <div class="absolute inset-0 grid-lines opacity-40" data-scrub="parallax" data-speed="0.06" aria-hidden="true"></div>

  <div class="container-narrow relative z-10">
    <div class="grid md:grid-cols-[1fr_auto] gap-12 items-center">
      <div>
        <div class="reveal">
          <p class="font-mono text-sm text-accent mb-4 tracking-wide">
            backend / devops / systems
          </p>
        </div>

        <h1 class="text-display font-heading text-text-primary mb-6 aurora-text" data-scrub="parallax" data-speed="0.08">
          Carlos García
        </h1>

        <p
          class="text-xl md:text-2xl text-text-secondary leading-relaxed max-w-2xl mb-8"
          data-scrub="fade"
        >
          I build software systems and automate the infrastructure that runs them.
        </p>

        <div class="flex flex-wrap items-center gap-4 reveal reveal-delay-3">
          <a
            href="#projects"
            class="inline-flex items-center px-6 py-3 bg-accent text-white font-medium rounded-md hover:bg-accent-muted transition-colors duration-150 pressable"
          >
            View Projects
          </a>
          <a
            href="https://github.com/carlosgarcia-tech"
            target="_blank"
            rel="noopener noreferrer"
            class="glass-chip rounded-md"
          >
            GitHub Profile
          </a>
          <a
            href="/cv-carlos-garcia.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="glass-chip rounded-md"
          >
            Download CV
          </a>
          <a
            href="https://www.linkedin.com/in/carlos-garcia-gg/"
            target="_blank"
            rel="noopener noreferrer"
            class="glass-chip rounded-md"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            LinkedIn
          </a>
        </div>

        <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="metric-card reveal reveal-delay-4">
            <span class="metric-value count-up-value">1010</span>
            <p class="metric-label">tests passing</p>
          </div>
          <div class="metric-card reveal reveal-delay-4">
            <span class="metric-value count-up-value">50+</span>
            <p class="metric-label">API endpoints</p>
          </div>
          <div class="metric-card reveal reveal-delay-5">
            <span class="metric-value count-up-value">200+</span>
            <p class="metric-label">commands</p>
          </div>
          <div class="metric-card reveal reveal-delay-5">
            <span class="metric-value count-up-value">50</span>
            <p class="metric-label">concurrent sessions</p>
          </div>
        </div>
      </div>

      <div class="hidden md:block">
        <div data-scrub="parallax" data-speed="0.15">
          <AsciiFigure />
        </div>
      </div>
    </div>
  </div>
</section>
