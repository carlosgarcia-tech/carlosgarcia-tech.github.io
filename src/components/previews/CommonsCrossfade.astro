---
/**
 * CommonsCrossfade — mini image crossfade carousel for home card.
 * Pure CSS crossfade between 3 panels, pauses when not in viewport.
 */
---

<div class="cc-carousel" data-preview="commons" aria-hidden="true">
  <div class="cc-slides">
    <div class="cc-slide cc-slide-1">
      <div class="cc-inner">
        <div class="cc-icon">🛒</div>
        <div class="cc-title">Marketplace</div>
        <div class="cc-subtitle">Users, stores, products</div>
      </div>
    </div>
    <div class="cc-slide cc-slide-2">
      <div class="cc-inner">
        <div class="cc-icon">💬</div>
        <div class="cc-title">Real-time Chat</div>
        <div class="cc-subtitle">Socket.io + Ably</div>
      </div>
    </div>
    <div class="cc-slide cc-slide-3">
      <div class="cc-inner">
        <div class="cc-icon">⚡</div>
        <div class="cc-title">Onion Architecture</div>
        <div class="cc-subtitle">1010 tests, 80% coverage</div>
      </div>
    </div>
  </div>
  <div class="cc-overlay">
    <span class="cc-cta">View project →</span>
  </div>
</div>

<script>
  function initCommonsCrossfade() {
    const roots = document.querySelectorAll('[data-preview="commons"]');
    roots.forEach(root => {
      let paused = true;
      const slides = root.querySelector('.cc-slides') as HTMLDivElement;
      let idx = 0;
      const total = 3;
      let intervalId = null;

      function tick() {
        if (!paused) {
          idx = (idx + 1) % total;
          slides.style.transform = `translateX(-${idx * 100}%)`;
        }
      }

      function startAnimation() {
        if (!paused) return;
        paused = false;
        intervalId = setInterval(tick, 3000);
      }

      function stopAnimation() {
        paused = true;
        if (intervalId) { clearInterval(intervalId); intervalId = null; }
      }

      const card = root.closest('a');
      if (card) {
        card.addEventListener('mouseenter', startAnimation);
        card.addEventListener('mouseleave', stopAnimation);
      }
    });
  }
  document.addEventListener('astro:page-load', initCommonsCrossfade);
  initCommonsCrossfade();
</script>

<style>
  .cc-carousel {
    position: relative;
    width: 100%;
    height: 160px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #1E293B;
  }
  .cc-slides {
    display: flex;
    width: 300%;
    height: 100%;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cc-slide {
    width: calc(100% / 3);
    height: 100%;
    flex-shrink: 0;
  }
  .cc-slide-1 { background: linear-gradient(135deg, #1a1f35 0%, #1E293B 100%); }
  .cc-slide-2 { background: linear-gradient(135deg, #0f1a2e 0%, #162033 100%); }
  .cc-slide-3 { background: linear-gradient(135deg, #151b2d 0%, #1a2540 100%); }

  .cc-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 6px;
  }
  .cc-icon { font-size: 28px; }
  .cc-title {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #F1F5F9;
  }
  .cc-subtitle {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #94A3B8;
  }
  .cc-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 14, 26, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .cc-carousel:hover .cc-overlay {
    opacity: 1;
  }
  .cc-cta {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #3B82F6;
    letter-spacing: 0.02em;
  }
</style>
