---
/**
 * DeployTerminalPreview — "Deployment Terminal + Pipeline"
 * Auto-typing terminal with ansible/docker commands, synchronized Blue/Green traffic switch.
 * Mock data, no backend.
 */
---

<div class="dt-preview" data-component="deploy-preview">
  <div
    class="dt-glass grid grid-cols-1 gap-0 overflow-hidden rounded-xl lg:grid-cols-2"
  >
    <!-- Left: Terminal -->
    <div class="dt-pane flex flex-col p-4 md:p-6">
      <div class="mb-4 flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-red-500/70"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/70"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-green-500/70"></span>
        <span class="ml-2 font-mono text-xs text-text-muted"
          >deploy.sh — bash</span
        >
        <button
          class="dt-run-btn ml-auto px-3 py-1.5 font-mono text-xs text-white"
          aria-label="Run deployment"
        >
          ▶ Run Deploy
        </button>
      </div>
      <div
        id="dt-terminal"
        class="dt-screen min-h-[280px] max-h-[400px] flex-1 overflow-y-auto font-mono text-xs leading-relaxed"
        aria-live="off"
      >
        <div class="text-text-muted">$ ./deploy.sh --env production</div>
      </div>
    </div>

    <!-- Right: Blue/Green Pipeline Diagram -->
    <div class="dt-pane dt-pane-right flex flex-col p-4 md:p-6">
      <div class="mb-4 flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-accent"></span>
        <span class="font-mono text-xs uppercase tracking-wider text-text-muted"
          >Traffic Pipeline</span
        >
      </div>

      <div class="flex flex-1 items-center justify-center">
        <svg
          viewBox="0 0 200 140"
          class="w-full max-w-[300px]"
          role="img"
          aria-label="Blue/Green deployment pipeline"
        >
          <!-- Users icon -->
          <g transform="translate(10,60)">
            <circle cx="10" cy="5" r="4" fill="#78716C"></circle>
            <path
              d="M2,15 Q10,20 18,15"
              stroke="#78716C"
              fill="none"
              stroke-width="1.5"></path>
            <text
              x="10"
              y="25"
              text-anchor="middle"
              fill="#78716C"
              font-size="6"
              font-family="JetBrains Mono, monospace">Users</text
            >
          </g>

          <!-- Users → Load balancer -->
          <line
            x1="30"
            y1="67"
            x2="50"
            y2="67"
            stroke="#A8A29E"
            stroke-width="1.5"
            stroke-dasharray="3,2"></line>
          <polygon points="48,64 54,67 48,70" fill="#A8A29E"></polygon>

          <!-- Load Balancer -->
          <rect x="55" y="55" width="30" height="24" rx="3" class="dt-lb"
          ></rect>
          <text
            x="70"
            y="66"
            text-anchor="middle"
            fill="#FF6B1C"
            font-size="5"
            font-family="JetBrains Mono, monospace">NGINX</text
          >
          <text
            x="70"
            y="74"
            text-anchor="middle"
            fill="#78716C"
            font-size="4"
            font-family="JetBrains Mono, monospace">LB</text
          >

          <!-- LB → Blue (las puntas de flecha ahora apuntan en la dirección de la línea) -->
          <g class="dt-link is-active" data-side="blue">
            <line
              x1="85"
              y1="62"
              x2="102"
              y2="45"
              stroke-width="1.5"
              stroke-dasharray="3,2"></line>
            <polygon points="106,41 103.9,47.3 99.7,43.1"></polygon>
          </g>

          <!-- LB → Green -->
          <g class="dt-link" data-side="green">
            <line
              x1="85"
              y1="72"
              x2="102"
              y2="89"
              stroke-width="1.5"
              stroke-dasharray="3,2"></line>
            <polygon points="106,93 103.9,86.7 99.7,90.9"></polygon>
          </g>

          <!-- Blue Server -->
          <g class="dt-node is-active" data-side="blue">
            <rect x="110" y="28" width="40" height="28" rx="3"></rect>
            <text
              x="130"
              y="40"
              text-anchor="middle"
              font-size="5.5"
              font-family="JetBrains Mono, monospace"
              font-weight="600"
              class="dt-name">BLUE</text
            >
            <text
              x="130"
              y="48"
              text-anchor="middle"
              font-size="4"
              font-family="JetBrains Mono, monospace"
              class="dt-ver">v1.8.2</text
            >
            <circle cx="148" cy="32" r="2.5" class="dt-dot"></circle>
          </g>

          <!-- Green Server -->
          <g class="dt-node" data-side="green">
            <rect x="110" y="78" width="40" height="28" rx="3"></rect>
            <text
              x="130"
              y="90"
              text-anchor="middle"
              font-size="5.5"
              font-family="JetBrains Mono, monospace"
              font-weight="600"
              class="dt-name">GREEN</text
            >
            <text
              x="130"
              y="98"
              text-anchor="middle"
              font-size="4"
              font-family="JetBrains Mono, monospace"
              class="dt-ver">v1.9.0</text
            >
            <circle cx="148" cy="82" r="2.5" class="dt-dot"></circle>
          </g>

          <!-- Traffic labels (movidos para que no se monten sobre las líneas) -->
          <text
            x="99"
            y="36"
            text-anchor="middle"
            font-size="4.5"
            font-family="JetBrains Mono, monospace"
            class="dt-pct dt-pct-blue is-active"
            data-side="blue">100%</text
          >
          <text
            x="99"
            y="104"
            text-anchor="middle"
            font-size="4.5"
            font-family="JetBrains Mono, monospace"
            class="dt-pct dt-pct-green"
            data-side="green">0%</text
          >
        </svg>
      </div>

      <div
        class="mt-4 flex items-center justify-center gap-4 font-mono text-[10px] text-text-muted"
      >
        <span class="flex items-center gap-1.5"
          ><span class="inline-block h-2 w-2 rounded-full bg-accent"></span> Active</span
        >
        <span class="flex items-center gap-1.5"
          ><span class="dt-standby inline-block h-2 w-2 rounded-full"></span> Standby</span
        >
      </div>
    </div>
  </div>
</div>

<script>
  function initDeployPreview() {
    const root = document.querySelector<HTMLElement>(
      '[data-component="deploy-preview"]',
    );
    // Evita listeners duplicados (astro:page-load + llamada directa):
    // antes cada init tenía su propio isRunning y el deploy corría dos veces.
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";

    const term = root.querySelector<HTMLDivElement>("#dt-terminal")!;
    const btn = root.querySelector<HTMLButtonElement>(".dt-run-btn")!;
    const sideEls = root.querySelectorAll<SVGElement>("[data-side]");
    const pctBlue = root.querySelector<SVGTextElement>(".dt-pct-blue")!;
    const pctGreen = root.querySelector<SVGTextElement>(".dt-pct-green")!;
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let isRunning = false;
    let timeouts: ReturnType<typeof setTimeout>[] = [];
    let intervals: ReturnType<typeof setInterval>[] = [];

    function later(fn: () => void, ms: number) {
      timeouts.push(setTimeout(fn, ms));
    }

    function clearAll() {
      timeouts.forEach((t) => clearTimeout(t));
      intervals.forEach((i) => clearInterval(i));
      timeouts = [];
      intervals = [];
    }

    // Una sola función para los dos estados del diagrama.
    // Antes solo existía switchToGreen y al volver a correr el deploy
    // el diagrama se quedaba en Green.
    function setActive(side: "blue" | "green") {
      sideEls.forEach((el) => {
        el.classList.toggle("is-active", el.getAttribute("data-side") === side);
      });
      pctBlue.textContent = side === "blue" ? "100%" : "0%";
      pctGreen.textContent = side === "green" ? "100%" : "0%";
    }

    function typeLine(
      text: string,
      delay: number,
      colorClass = "text-text-primary",
    ) {
      later(() => {
        const div = document.createElement("div");
        div.className = colorClass;
        term.appendChild(div);

        if (reduce) {
          div.textContent = text;
          term.scrollTop = term.scrollHeight;
          return;
        }

        let i = 0;
        const interval = setInterval(() => {
          if (i < text.length) {
            div.textContent += text[i];
            i++;
            term.scrollTop = term.scrollHeight;
          } else {
            clearInterval(interval);
          }
        }, 18);
        intervals.push(interval);
      }, delay);
    }

    function addLine(
      text: string,
      delay: number,
      colorClass = "text-text-primary",
    ) {
      later(() => {
        const div = document.createElement("div");
        div.className = colorClass;
        div.textContent = text;
        term.appendChild(div);
        term.scrollTop = term.scrollHeight;
      }, delay);
    }

    function runDeploy() {
      if (isRunning) return;
      isRunning = true;
      btn.textContent = "⟳ Running...";
      btn.disabled = true;

      clearAll();
      term.innerHTML = "";
      setActive("blue");

      typeLine("$ ./deploy.sh --env production", 0, "text-text-muted");
      typeLine("Deploying to production cluster...", 600, "text-text-primary");

      addLine(
        "Step 1/5: Running Ansible playbook...",
        1300,
        "text-text-secondary",
      );
      addLine("  PLAY [webservers] ******", 1600, "text-cyan");
      addLine("  TASK [Gathering Facts]", 1800, "text-text-secondary");
      addLine("    ok: [web-01.prod]", 2000, "text-emerald");
      addLine("    ok: [web-02.prod]", 2100, "text-emerald");
      addLine("  PLAY RECAP", 2300, "text-text-secondary");
      addLine(
        "    web-01.prod: ok=8  changed=0  unreachable=0",
        2500,
        "text-emerald",
      );
      addLine(
        "    web-02.prod: ok=8  changed=0  unreachable=0",
        2550,
        "text-emerald",
      );

      addLine(
        "Step 2/5: Building Docker image...",
        3000,
        "text-text-secondary",
      );
      addLine("  => [internal] load .dockerignore", 3300, "text-text-muted");
      addLine("  => [internal] load build definition", 3400, "text-text-muted");
      addLine("  => [stage-0] node:20-alpine", 3600, "text-text-muted");
      addLine("  => [stage-1] npm ci --production", 3900, "text-text-muted");
      addLine("  => exporting to image", 4300, "text-text-muted");

      addLine("Step 3/5: Running tests...", 4700, "text-text-secondary");
      addLine("  ✓ unit tests (47 passed)", 5100, "text-emerald");
      addLine("  ✓ integration tests (23 passed)", 5300, "text-emerald");
      addLine("  ✓ e2e tests (12 passed)", 5500, "text-emerald");

      addLine(
        "Step 4/5: Rolling update (Blue → Green)...",
        6000,
        "text-text-secondary",
      );
      addLine("  Draining Blue connections...", 6300, "text-amber-700");
      addLine("  Blue idle, routing 100% to Green...", 6700, "text-amber-700");

      // Cambio visual sincronizado con el log
      later(() => setActive("green"), 7000);

      addLine("  ✓ Blue drained. Green active.", 7300, "text-emerald");

      addLine("Step 5/5: Health check...", 7700, "text-text-secondary");
      addLine("  GET /health → 200 OK (12ms)", 8000, "text-emerald");
      addLine("  GET /health → 200 OK (8ms)", 8200, "text-emerald");

      addLine("", 8500);
      typeLine('$ echo "Deploy complete!"', 8600, "text-text-muted");
      addLine("Deploy complete!", 9250, "text-accent font-semibold");

      // Ahora entra en `timeouts`, así clearAll() también lo cancela
      later(() => {
        isRunning = false;
        btn.textContent = "▶ Run Deploy";
        btn.disabled = false;
      }, 9800);
    }

    btn.addEventListener("click", runDeploy);

    // Auto-play demo when widget enters viewport
    let autoPlayed = false;
    const autoPlayObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !autoPlayed) {
            autoPlayed = true;
            autoPlayObserver.disconnect();
            setTimeout(() => runDeploy(), 500);
          }
        });
      },
      { threshold: 0.3 },
    );
    autoPlayObserver.observe(root);
  }

  document.addEventListener("astro:page-load", initDeployPreview);
  initDeployPreview();
</script>

<style>
  /* ─── Liquid glass ─── */
  .dt-glass {
    position: relative;
    border: 1px solid rgb(255 255 255 / 0.6);
    background:
      linear-gradient(
        115deg,
        rgb(255 255 255 / 0.34) 0%,
        rgb(255 255 255 / 0.06) 30%,
        rgb(255 255 255 / 0) 55%,
        rgb(255 255 255 / 0.12) 100%
      ),
      rgb(255 255 255 / 0.05);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      inset 1px 0 0 rgb(255 255 255 / 0.35),
      inset -1px 0 0 rgb(255 255 255 / 0.15),
      inset 0 -12px 26px -12px rgb(255 255 255 / 0.5),
      inset 0 -1px 0 rgb(11 18 32 / 0.08),
      0 22px 50px -20px rgb(11 18 32 / 0.3),
      0 12px 30px -14px rgb(255 107 28 / 0.4);
    -webkit-backdrop-filter: blur(6px) saturate(210%) brightness(1.04);
    backdrop-filter: blur(6px) saturate(210%) brightness(1.04);
  }

  .dt-pane-right {
    border-top: 1px solid rgb(255 255 255 / 0.55);
  }
  @media (min-width: 1024px) {
    .dt-pane-right {
      border-top: 0;
      border-left: 1px solid rgb(255 255 255 / 0.55);
    }
  }

  /* Pantalla del terminal: cristal un poco más oscuro, para que el texto lea
     bien sobre un fondo transparente */
  .dt-screen {
    border-radius: 10px;
    padding: 12px;
    background: rgb(11 18 32 / 0.045);
    border: 1px solid rgb(255 255 255 / 0.5);
    box-shadow:
      inset 0 2px 8px rgb(11 18 32 / 0.08),
      inset 0 1px 0 rgb(11 18 32 / 0.04);
  }

  /* Botón: cristal naranja */
  .dt-run-btn {
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.55);
    background: linear-gradient(
      180deg,
      rgb(255 107 28 / 0.95) 0%,
      rgb(224 86 24 / 0.92) 100%
    );
    box-shadow:
      inset 0 1.5px 0 rgb(255 255 255 / 0.65),
      inset 0 -1px 0 rgb(0 0 0 / 0.12),
      0 6px 18px -6px rgb(255 107 28 / 0.6);
    transition:
      box-shadow 200ms ease,
      transform 100ms ease-out,
      opacity 150ms ease;
  }
  .dt-run-btn:hover:not(:disabled) {
    box-shadow:
      inset 0 1.5px 0 rgb(255 255 255 / 0.8),
      inset 0 -1px 0 rgb(0 0 0 / 0.12),
      0 10px 26px -8px rgb(255 107 28 / 0.75);
  }
  .dt-run-btn:active:not(:disabled) {
    transform: scale(0.96);
  }
  .dt-run-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .dt-standby {
    background: #d6d3d1;
  }

  /* ─── Diagrama: los estados viven en CSS (antes eran atributos cambiados por JS) ─── */
  .dt-lb {
    fill: rgb(255 255 255 / 0.4);
    stroke: #ff6b1c;
    stroke-width: 1;
  }

  .dt-node rect {
    fill: rgb(255 255 255 / 0.3);
    stroke: rgb(120 113 108 / 0.5);
    stroke-width: 1;
    transition:
      stroke 0.4s ease,
      fill 0.4s ease;
  }
  .dt-node .dt-name {
    fill: #78716c;
    transition: fill 0.4s ease;
  }
  .dt-node .dt-ver {
    fill: #a8a29e;
  }
  .dt-node .dt-dot {
    fill: #d6d3d1;
    transition: fill 0.4s ease;
  }
  .dt-node.is-active rect {
    fill: rgb(255 255 255 / 0.6);
    stroke: #ff6b1c;
    stroke-width: 1.5;
    filter: drop-shadow(0 0 4px rgb(255 107 28 / 0.45));
  }
  .dt-node.is-active .dt-name {
    fill: #ff6b1c;
  }
  .dt-node.is-active .dt-ver {
    fill: #78716c;
  }
  .dt-node.is-active .dt-dot {
    fill: #ff6b1c;
    animation: dt-pulse 2s ease-in-out infinite;
  }

  .dt-link {
    opacity: 0.45;
    transition: opacity 0.4s ease;
  }
  .dt-link line {
    stroke: #a8a29e;
  }
  .dt-link polygon {
    fill: #a8a29e;
  }
  .dt-link.is-active {
    opacity: 1;
  }
  .dt-link.is-active line {
    stroke: #ff6b1c;
  }
  .dt-link.is-active polygon {
    fill: #ff6b1c;
  }

  .dt-pct {
    fill: #a8a29e;
    opacity: 0.65;
    transition:
      fill 0.4s ease,
      opacity 0.4s ease;
  }
  .dt-pct.is-active {
    fill: #ff6b1c;
    opacity: 1;
  }

  @keyframes dt-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-contrast: more), (prefers-reduced-transparency: reduce) {
    .dt-glass {
      background: rgb(255 255 255 / 0.95);
      border-color: rgb(0 0 0 / 0.4);
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dt-node.is-active .dt-dot {
      animation: none;
    }
  }
</style>
