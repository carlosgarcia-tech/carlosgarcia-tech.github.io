---
/**
 * DeployMini — small auto-typing terminal for the home card.
 * At rest it shows the finished output (never an empty box).
 * On hover/focus the 4 lines type out in sequence and loop.
 */
const lines = [
  { text: "$ ansible-playbook deploy.yml", kind: "cmd" },
  { text: "✓ Health check passed", kind: "ok" },
  { text: "$ docker compose up -d", kind: "cmd" },
  { text: "✓ Green → Blue traffic switched", kind: "ok" },
];
---

<div class="dm-terminal" data-preview="deploy" aria-hidden="true">
  <div class="dm-dots">
    <span class="dm-dot-red"></span>
    <span class="dm-dot-yellow"></span>
    <span class="dm-dot-green"></span>
  </div>
  <div class="dm-body">
    {
      lines.map((l) => (
        <div class={`dm-line dm-${l.kind}`} data-type={l.text}>
          {l.text}
        </div>
      ))
    }
  </div>
</div>

<script>
  function initDeployMini() {
    const roots = document.querySelectorAll<HTMLElement>(
      '[data-preview="deploy"]',
    );

    roots.forEach((root) => {
      // Evita listeners duplicados (astro:page-load + llamada directa)
      if (root.dataset.ready) return;
      root.dataset.ready = "true";

      const lines = Array.from(root.querySelectorAll<HTMLElement>(".dm-line"));
      const texts = lines.map((l) => l.dataset.type ?? "");
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      let timer: ReturnType<typeof setTimeout> | null = null;
      let running = false;
      let runId = 0; // invalida callbacks viejos al parar o reiniciar

      function showAll() {
        lines.forEach((l, i) => {
          l.textContent = texts[i];
          l.style.opacity = "1";
          l.classList.remove("is-typing");
        });
      }

      function clear() {
        lines.forEach((l) => {
          l.textContent = "";
          l.style.opacity = "0";
          l.classList.remove("is-typing");
        });
      }

      function typeLine(i: number, id: number) {
        if (id !== runId) return;

        if (i >= lines.length) {
          // Pausa con todo escrito, luego repite
          timer = setTimeout(() => {
            if (id !== runId) return;
            clear();
            timer = setTimeout(() => typeLine(0, id), 500);
          }, 2500);
          return;
        }

        const el = lines[i];
        const text = texts[i];
        let c = 0;
        el.style.opacity = "1";
        el.classList.add("is-typing");

        const step = () => {
          if (id !== runId) return;
          if (c < text.length) {
            c++;
            el.textContent = text.slice(0, c);
            timer = setTimeout(step, 30 + Math.random() * 25);
          } else {
            el.classList.remove("is-typing");
            timer = setTimeout(() => typeLine(i + 1, id), 250);
          }
        };
        step();
      }

      function start() {
        if (running || reduce) return;
        running = true;
        runId++;
        clear();
        const id = runId;
        timer = setTimeout(() => typeLine(0, id), 400);
      }

      function stop() {
        runId++;
        if (timer) clearTimeout(timer);
        timer = null;
        running = false;
        showAll();
      }

      const card = root.closest("a");
      if (!card) return;
      card.addEventListener("mouseenter", start);
      card.addEventListener("mouseleave", stop);
      card.addEventListener("focusin", start);
      card.addEventListener("focusout", stop);
    });
  }

  document.addEventListener("astro:page-load", initDeployMini);
  initDeployMini();
</script>

<style>
  /* Sin backdrop-filter: va dentro de una card glass y el blur anidado se
     vería plano. El cristal sale de gradientes translúcidos, borde brillante
     y reflejo diagonal. */
  .dm-terminal {
    position: relative;
    width: 100%;
    height: 160px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.7);
    background: linear-gradient(
      160deg,
      rgb(255 255 255 / 0.3) 0%,
      rgb(255 255 255 / 0.08) 50%,
      rgb(255 255 255 / 0.2) 100%
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      inset 1px 0 0 rgb(255 255 255 / 0.35),
      inset 0 -10px 22px -12px rgb(255 255 255 / 0.5),
      inset 0 -1px 0 rgb(11 18 32 / 0.08),
      0 10px 24px -14px rgb(255 107 28 / 0.45);
    display: flex;
    flex-direction: column;
    color: #3f3f46;
  }

  .dm-terminal::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      rgb(255 255 255 / 0.35) 0%,
      rgb(255 255 255 / 0.06) 30%,
      rgb(255 255 255 / 0) 55%,
      rgb(255 255 255 / 0.12) 100%
    );
  }

  .dm-dots {
    display: flex;
    gap: 5px;
    padding: 8px 12px;
    border-bottom: 1px solid rgb(255 255 255 / 0.55);
    background: rgb(255 255 255 / 0.18);
  }
  .dm-dot-red,
  .dm-dot-yellow,
  .dm-dot-green {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.6);
  }
  .dm-dot-red {
    background: rgb(239 68 68 / 0.75);
  }
  .dm-dot-yellow {
    background: rgb(234 179 8 / 0.75);
  }
  .dm-dot-green {
    background: rgb(34 197 94 / 0.75);
  }

  .dm-body {
    flex: 1;
    padding: 10px 14px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
  }

  .dm-line {
    white-space: nowrap;
    overflow: hidden;
    min-height: 1.7em;
    transition: opacity 0.15s ease;
  }
  /* Antes data-color no se aplicaba: ahora cada tipo tiene su color */
  .dm-cmd {
    color: #3f3f46;
  }
  .dm-ok {
    color: #1e7a45;
  }

  .dm-line.is-typing::after {
    content: "▋";
    margin-left: 1px;
    color: #ff6b1c;
    animation: dm-blink 0.9s step-end infinite;
  }

  @keyframes dm-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dm-line.is-typing::after {
      animation: none;
    }
  }
</style>
