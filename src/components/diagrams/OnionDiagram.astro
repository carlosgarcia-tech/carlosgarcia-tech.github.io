---
const layers = [
  {
    name: "Presentation",
    detail: "Controllers, Routes, Middlewares",
    long: "Controllers, Routes, Middlewares — the HTTP layer that receives requests",
    color: "#EA580C",
    radius: 140,
    flow: "Receives the HTTP request, validates it, and calls the use case.",
  },
  {
    name: "Infrastructure",
    detail: "MongoDB, Supabase, Ably, Socket.io, DI",
    long: "MongoDB, Supabase, Ably, Socket.io — external integrations",
    color: "#f57c00",
    radius: 110,
    flow: "Implements the Core interfaces: saves to MongoDB, uploads to Supabase.",
  },
  {
    name: "Application",
    detail: "Use Cases, DTOs",
    long: "Use Cases, DTOs — orchestration and data transfer",
    color: "#DC2626",
    radius: 80,
    flow: "Orchestrates the logic: uses entities and repositories (interfaces only).",
  },
  {
    name: "Core",
    detail: "Entities, Repository Interfaces, Domain Services",
    long: "Entities, Repository Interfaces — domain with no dependencies",
    color: "#15803D",
    radius: 50,
    flow: "Pure business rules. It knows no framework.",
  },
];
---

<div
  class="onion-diagram relative w-full max-w-lg mx-auto"
  data-component="onion"
  data-layers={JSON.stringify(
    layers.map((l) => ({ name: l.name, long: l.long, flow: l.flow })),
  )}
>
  <svg
    viewBox="0 0 340 340"
    class="w-full h-auto"
    role="group"
    aria-label="Onion Architecture diagram: concentric layers from Presentation to Core"
  >
    <defs>
      <filter id="onion-glow">
        <feGaussianBlur stdDeviation="4" result="blur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="blur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    <!-- Dependency arrows (all point inward) -->
    <g class="onion-arrows" aria-hidden="true">
      {
        [0, 1, 2].map((i) => (
          <line
            x1="170"
            y1={170 - layers[i].radius + 4}
            x2="170"
            y2={170 - layers[i + 1].radius - 4}
            stroke={layers[i].color}
            stroke-width="1.5"
            stroke-dasharray="3 3"
            class="onion-dep"
          />
        ))
      }
    </g>

    {
      layers.map((layer, i) => (
        <circle
          cx="170"
          cy="170"
          r={layer.radius}
          fill={layer.color}
          fill-opacity="0.04"
          stroke={layer.color}
          stroke-width="2"
          opacity="0.6"
          class="onion-ring"
          data-layer={i}
          tabindex="0"
          role="button"
          aria-label={`${layer.name}: ${layer.detail}`}
        />
      ))
    }

    {
      layers.slice(0, -1).map((layer, i) => (
        <text
          x="170"
          y={170 - layer.radius + 18}
          text-anchor="middle"
          fill={layer.color}
          font-family="JetBrains Mono, monospace"
          font-size="10"
          font-weight="600"
          class="onion-ring-text"
          pointer-events="none"
        >
          {layer.name}
        </text>
      ))
    }

    <text
      x="170"
      y="170"
      text-anchor="middle"
      fill="#15803D"
      font-family="JetBrains Mono, monospace"
      font-size="10"
      font-weight="600"
      dominant-baseline="middle"
      class="onion-ring-text"
      pointer-events="none"
    >
      Core
    </text>

    <!-- Dot that travels from outside to inside, showing the direction of dependencies -->
    <circle
      r="4"
      fill="#FF6B1C"
      class="onion-dot"
      cx="170"
      cy="30"
      opacity="0"
      aria-hidden="true"></circle>
  </svg>

  <div class="onion-detail mt-4 w-full text-center" aria-live="polite">
    <p
      class="font-mono text-sm text-text-secondary min-h-[2.5rem] flex items-center justify-center"
      id="onion-detail-text"
    >
      <span class="text-text-muted"
        >Hover over (or tap) a layer to see its content</span
      >
    </p>
    <button
      type="button"
      class="onion-play font-mono text-xs text-accent hover:text-accent-muted transition-colors duration-150 mt-2"
    >
      ▶ View the flow of a request
    </button>
  </div>
</div>

<script>
  function initOnionDiagram() {
    document
      .querySelectorAll<HTMLElement>('[data-component="onion"]')
      .forEach((diagram) => {
        // Avoid duplicate listeners (astro:page-load + direct call)
        if (diagram.dataset.ready) return;
        diagram.dataset.ready = "true";

        const rings = Array.from(
          diagram.querySelectorAll<SVGCircleElement>(".onion-ring"),
        );
        const detailText =
          diagram.querySelector<HTMLElement>("#onion-detail-text");
        const dot = diagram.querySelector<SVGCircleElement>(".onion-dot");
        const playBtn = diagram.querySelector<HTMLButtonElement>(".onion-play");
        const layerData: { name: string; long: string; flow: string }[] =
          JSON.parse(diagram.dataset.layers || "[]");
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        const DEFAULT_TEXT =
          '<span class="text-text-muted">Hover over (or tap) a layer to see its content</span>';

        let activeLayer: number | null = null;
        let playing = false;
        let timers: ReturnType<typeof setTimeout>[] = [];

        function setDetail(index: number, text: string) {
          if (!detailText) return;
          detailText.replaceChildren();
          const name = document.createElement("span");
          name.className = "text-accent font-semibold";
          name.textContent = layerData[index].name;
          const sep = document.createElement("span");
          sep.className = "mx-2 text-text-muted";
          sep.textContent = "—";
          const body = document.createElement("span");
          body.className = "text-text-secondary";
          body.textContent = text;
          detailText.append(name, sep, body);
        }

        function highlightLayer(index: number, text?: string) {
          activeLayer = index;
          rings.forEach((el, i) => {
            if (i === index) {
              el.setAttribute("stroke-width", "4");
              el.setAttribute("opacity", "1");
              el.setAttribute("filter", "url(#onion-glow)");
            } else if (i > index) {
              // inner layers: the ones the active layer depends on
              el.setAttribute("stroke-width", "2");
              el.setAttribute("opacity", "0.9");
              el.removeAttribute("filter");
            } else {
              el.setAttribute("stroke-width", "1.5");
              el.setAttribute("opacity", "0.3");
              el.removeAttribute("filter");
            }
          });
          setDetail(index, text ?? layerData[index].long);
        }

        function resetDiagram() {
          if (playing) return;
          activeLayer = null;
          rings.forEach((el) => {
            el.setAttribute("stroke-width", "2");
            el.setAttribute("opacity", "0.6");
            el.removeAttribute("filter");
          });
          if (detailText) detailText.innerHTML = DEFAULT_TEXT;
        }

        rings.forEach((ring, i) => {
          ring.addEventListener(
            "mouseenter",
            () => !playing && highlightLayer(i),
          );
          ring.addEventListener("mouseleave", resetDiagram);
          ring.addEventListener("focus", () => !playing && highlightLayer(i));
          ring.addEventListener("blur", resetDiagram);
          ring.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight" || e.key === "ArrowDown") {
              e.preventDefault();
              rings[(i + 1) % rings.length].focus();
            } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
              e.preventDefault();
              rings[(i - 1 + rings.length) % rings.length].focus();
            }
          });
          ring.addEventListener(
            "touchstart",
            (e) => {
              e.preventDefault();
              if (playing) return;
              if (activeLayer === i) resetDiagram();
              else highlightLayer(i);
            },
            { passive: false },
          );
        });

        // Tapping outside the rings resets
        diagram.addEventListener("touchstart", (e) => {
          if (!(e.target as Element).closest(".onion-ring, .onion-play"))
            resetDiagram();
        });

        // Animation: a request crosses the layers from outside to inside
        function stopPlay() {
          timers.forEach(clearTimeout);
          timers = [];
          playing = false;
          if (dot) dot.setAttribute("opacity", "0");
          if (playBtn) playBtn.textContent = "▶ View the flow of a request";
          resetDiagram();
        }

        playBtn?.addEventListener("click", () => {
          if (playing) return stopPlay();
          playing = true;
          if (playBtn) playBtn.textContent = "■ Stop";
          const ys = [30, 60, 90, 120];
          layerData.forEach((_, i) => {
            timers.push(
              setTimeout(
                () => {
                  highlightLayer(i, layerData[i].flow);
                  if (dot) {
                    dot.setAttribute("opacity", "1");
                    dot.setAttribute("cy", String(ys[i] + (i === 3 ? 20 : 0)));
                    if (!reduce) dot.style.transition = "cy 0.5s ease";
                  }
                },
                i * (reduce ? 1200 : 1100),
              ),
            );
          });
          timers.push(setTimeout(stopPlay, layerData.length * 1100 + 1400));
        });
      });
  }

  document.addEventListener("astro:page-load", initOnionDiagram);
  initOnionDiagram();
</script>

<style>
  .onion-ring {
    cursor: pointer;
    transform-origin: center;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }
  .onion-ring:focus-visible {
    stroke-dasharray: 6 4;
  }
  .onion-dep {
    animation: onion-dash 1.4s linear infinite;
  }
  @keyframes onion-dash {
    to {
      stroke-dashoffset: -12;
    }
  }
  .onion-dot {
    transition: opacity 0.3s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .onion-dep {
      animation: none;
    }
    .onion-ring {
      transition: none;
    }
  }
</style>
