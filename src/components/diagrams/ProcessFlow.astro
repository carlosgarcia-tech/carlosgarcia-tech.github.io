---
const steps = [
  {
    label: "Build",
    detail: "Write code with clear architecture",
    icon: "{ }",
    long: "Código con arquitectura clara",
    more: "separación de responsabilidades, interfaces limpias",
  },
  {
    label: "Test",
    detail: "Verify with automated tests",
    icon: "✓",
    long: "Pruebas automatizadas",
    more: "casos de uso, entidades, validadores",
  },
  {
    label: "Containerize",
    detail: "Package with Docker",
    icon: "◻",
    long: "Docker para consistencia",
    more: "builds reproducibles, entornos aislados",
  },
  {
    label: "Automate",
    detail: "Infrastructure as code",
    icon: "⚙",
    long: "Infraestructura como código con Ansible",
    more: "aprovisionamiento y gestión de configuración",
  },
  {
    label: "Deploy",
    detail: "CI/CD with Blue/Green",
    icon: "↑",
    long: "CI/CD con despliegue Blue/Green",
    more: "releases sin downtime, rollback instantáneo",
  },
  {
    label: "Monitor",
    detail: "Health checks and recovery",
    icon: "◉",
    long: "Health checks y recuperación",
    more: "monitoreo, reinicio automático",
  },
];
const STEP_X = 130;
const lineX = (i: number) => ({
  x1: 10 + i * STEP_X + 88,
  x2: 10 + (i + 1) * STEP_X + 12,
});
---

<section
  class="section-spacing border-t border-surface-border"
  data-component="process-flow"
  data-steps={JSON.stringify(
    steps.map((s) => ({ long: s.long, more: s.more })),
  )}
>
  <div class="container-narrow">
    <div class="mb-12 reveal">
      <p class="font-mono text-sm text-accent mb-2">How I work</p>
      <h2 class="text-headline font-heading text-text-primary">
        Engineering focus
      </h2>
      <p class="text-text-secondary mt-3 max-w-xl">
        The path from code to production — every project follows this
        progression.
      </p>
    </div>

    <!-- Desktop: diagrama horizontal -->
    <div class="hidden md:block reveal reveal-delay-1" data-flow-desktop>
      <div class="relative">
        <svg
          viewBox="0 0 800 120"
          class="w-full h-auto"
          role="group"
          aria-label="Flujo de ingeniería de Build a Monitor"
        >
          {
            steps.slice(0, -1).map((_, i) => {
              const { x1, x2 } = lineX(i);
              const len = x2 - x1;
              return (
                <line
                  x1={x1}
                  y1="55"
                  x2={x2}
                  y2="55"
                  stroke="#D6D3D1"
                  stroke-width="1.5"
                  stroke-dasharray={`${len}`}
                  stroke-dashoffset={`${len}`}
                  class="flow-line"
                  data-length={len}
                />
              );
            })
          }

          {
            steps.slice(0, -1).map((_, i) => {
              const { x1, x2 } = lineX(i);
              return (
                <g class="flow-particle" opacity="0" aria-hidden="true">
                  <circle r="2.5" fill="#FF6B1C" cy="55">
                    <animate
                      attributeName="cx"
                      from={x1}
                      to={x2}
                      dur="1.5s"
                      begin={`${i * 0.3}s`}
                      repeatCount="indefinite"
                    />
                  </circle>
                </g>
              );
            })
          }

          {
            steps.map((step, i) => {
              const x = 10 + i * STEP_X;
              return (
                <g
                  class="flow-node"
                  data-index={i}
                  tabindex="0"
                  role="button"
                  aria-label={`${step.label}: ${step.detail}`}
                >
                  <circle
                    cx={x + 50}
                    cy="55"
                    r="38"
                    fill="#FFFFFF"
                    stroke="#D6D3D1"
                    stroke-width="2"
                    class="node-circle"
                  />
                  <circle
                    cx={x + 50}
                    cy="55"
                    r="44"
                    fill="none"
                    stroke="#FF6B1C"
                    stroke-width="0"
                    stroke-opacity="0.25"
                    class="node-glow"
                  />
                  <text
                    x={x + 50}
                    y="52"
                    text-anchor="middle"
                    fill="#FF6B1C"
                    font-family="JetBrains Mono, monospace"
                    font-size="14"
                    pointer-events="none"
                  >
                    {step.icon}
                  </text>
                  <text
                    x={x + 50}
                    y="72"
                    text-anchor="middle"
                    fill="#27272A"
                    font-family="JetBrains Mono, monospace"
                    font-size="9"
                    font-weight="600"
                    pointer-events="none"
                  >
                    {step.label}
                  </text>
                </g>
              );
            })
          }
        </svg>

        <div
          class="mt-4 text-center min-h-[2rem]"
          data-flow-detail
          aria-live="polite"
        >
          <span class="text-text-muted text-sm"
            >Hover o haz clic en cada paso para explorar el proceso</span
          >
        </div>
        <div class="text-center mt-2">
          <button
            type="button"
            data-flow-replay
            class="font-mono text-xs text-accent hover:text-accent-muted transition-colors duration-150"
            >↻ Repetir animación</button
          >
        </div>
      </div>
    </div>

    <!-- Mobile: lista vertical -->
    <div class="md:hidden">
      <div class="relative pl-8">
        <div class="absolute left-3 top-0 bottom-0 w-px bg-surface-border">
        </div>
        {
          steps.map((step, i) => (
            <div
              class={`relative mb-6 last:mb-0 reveal reveal-delay-${Math.min(i + 1, 4)}`}
            >
              <div
                class="absolute -left-5 w-4 h-4 rounded-full border-2 border-accent bg-surface"
                style="top: 2px;"
              />
              <div class="card-surface p-4">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-mono text-xs text-accent">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <h3 class="font-heading font-semibold text-text-primary text-sm">
                    {step.label}
                  </h3>
                </div>
                <p class="text-text-muted text-xs">{step.detail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function initProcessFlow() {
    document
      .querySelectorAll<HTMLElement>('[data-component="process-flow"]')
      .forEach((section) => {
        if (section.dataset.ready) return;
        section.dataset.ready = "true";

        const root = section.querySelector<HTMLElement>("[data-flow-desktop]");
        if (!root) return;

        const nodes = Array.from(
          root.querySelectorAll<SVGGElement>(".flow-node"),
        );
        const circles = Array.from(
          root.querySelectorAll<SVGCircleElement>(".node-circle"),
        );
        const glows = Array.from(
          root.querySelectorAll<SVGCircleElement>(".node-glow"),
        );
        const lines = Array.from(
          root.querySelectorAll<SVGLineElement>(".flow-line"),
        );
        const particles = Array.from(
          root.querySelectorAll<SVGGElement>(".flow-particle"),
        );
        const detailEl = root.querySelector<HTMLElement>("[data-flow-detail]");
        const replay =
          root.querySelector<HTMLButtonElement>("[data-flow-replay]");
        const details: { long: string; more: string }[] = JSON.parse(
          section.dataset.steps || "[]",
        );
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        const DEFAULT_TEXT =
          '<span class="text-text-muted text-sm">Hover o haz clic en cada paso para explorar el proceso</span>';

        let activeStep = -1;
        let timer: ReturnType<typeof setTimeout> | undefined;
        let hovering = false;

        function activateStep(i: number) {
          if (i === activeStep) return;
          activeStep = i;

          circles.forEach((el, j) => {
            el.setAttribute("stroke", j <= i ? "#FF6B1C" : "#D6D3D1");
            el.setAttribute("stroke-width", j === i ? "3" : "2");
          });
          glows.forEach((el, j) =>
            el.setAttribute("stroke-width", j === i ? "6" : "0"),
          );

          lines.forEach((el, j) => {
            const len = el.dataset.length || "20";
            el.setAttribute("stroke-dasharray", len);
            if (j < i) {
              el.setAttribute("stroke", "#FF6B1C");
              el.setAttribute("stroke-width", "2");
              el.setAttribute("stroke-dashoffset", "0");
            } else {
              el.setAttribute("stroke", "#D6D3D1");
              el.setAttribute("stroke-width", "1.5");
              el.setAttribute("stroke-dashoffset", len);
            }
          });

          particles.forEach((el, j) =>
            el.setAttribute("opacity", !reduce && j < i ? "0.9" : "0"),
          );

          if (detailEl && i >= 0 && details[i]) {
            detailEl.replaceChildren();
            const a = document.createElement("span");
            a.className = "text-accent font-semibold";
            a.textContent = details[i].long;
            const sep = document.createElement("span");
            sep.className = "text-text-muted";
            sep.textContent = " — ";
            const b = document.createElement("span");
            b.className = "text-text-secondary";
            b.textContent = details[i].more;
            detailEl.append(a, sep, b);
          }
        }

        function reset() {
          clearTimeout(timer);
          activeStep = -1;
          circles.forEach((el) => {
            el.setAttribute("stroke", "#D6D3D1");
            el.setAttribute("stroke-width", "2");
          });
          glows.forEach((el) => el.setAttribute("stroke-width", "0"));
          lines.forEach((el) => {
            const len = el.dataset.length || "20";
            el.setAttribute("stroke", "#D6D3D1");
            el.setAttribute("stroke-width", "1.5");
            el.setAttribute("stroke-dasharray", len);
            el.setAttribute("stroke-dashoffset", len);
          });
          particles.forEach((el) => el.setAttribute("opacity", "0"));
          if (detailEl) detailEl.innerHTML = DEFAULT_TEXT;
        }

        // Activa los pasos en secuencia empezando en "from"
        function run(from = 0) {
          clearTimeout(timer);
          let step = from;
          const next = () => {
            if (hovering || step >= nodes.length) return;
            activateStep(step++);
            timer = setTimeout(next, reduce ? 0 : 450);
          };
          next();
        }

        nodes.forEach((node, i) => {
          node.addEventListener("mouseenter", () => {
            hovering = true;
            clearTimeout(timer);
            activateStep(i);
          });
          node.addEventListener("mouseleave", () => {
            hovering = false;
            run(i + 1);
          });
          node.addEventListener("click", () => {
            clearTimeout(timer);
            activateStep(i);
          });
          node.addEventListener("focus", () => {
            clearTimeout(timer);
            activateStep(i);
          });
          node.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight")
              nodes[Math.min(i + 1, nodes.length - 1)].focus();
            if (e.key === "ArrowLeft") nodes[Math.max(i - 1, 0)].focus();
          });
        });

        replay?.addEventListener("click", () => {
          reset();
          run(0);
        });

        // Una sola vez al entrar al viewport; se reinicia al salir
        const observer = new IntersectionObserver(
          ([e]) => {
            if (e.isIntersecting) {
              if (activeStep === -1) run(0);
            } else {
              reset();
            }
          },
          { threshold: 0.4 },
        );
        observer.observe(root);
      });
  }

  document.addEventListener("astro:page-load", initProcessFlow);
  initProcessFlow();
</script>

<style>
  .flow-node {
    cursor: pointer;
    outline: none;
  }
  .flow-node:focus-visible .node-circle {
    stroke-dasharray: 5 3;
  }
  .node-circle,
  .node-glow {
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .flow-line {
    transition:
      stroke-dashoffset 0.6s ease-out,
      stroke 0.3s ease;
  }
  .flow-particle {
    transition: opacity 0.3s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .node-circle,
    .node-glow,
    .flow-line,
    .flow-particle {
      transition: none;
    }
  }
</style>
