---
const pipeline = [
  { label: 'Request', icon: '→', color: '#78716C' },
  { label: 'JWT Auth', sublabel: 'access + refresh', color: '#FF6B1C' },
  { label: 'RBAC', sublabel: 'Admin / Editor / Viewer', color: '#DC2626' },
  { label: 'Rate Limit', sublabel: 'Redis + fallback', color: '#F59E0B' },
  { label: 'Cache Check', sublabel: 'Redis lookup', color: '#D97706' },
  { label: 'Controller', sublabel: 'Express route', color: '#16A34A' },
  { label: 'MongoDB', sublabel: 'Mongoose query', color: '#15803D' },
  { label: 'Response', sublabel: 'JSON', color: '#78716C' },
];
---

<div class="pathfinder-diagram w-full overflow-x-auto" data-component="pathfinder">
  <div class="min-w-[700px] px-4">
    <svg viewBox="0 0 720 160" class="w-full h-auto" role="img" aria-label="PathFinder API request pipeline diagram">
      <defs>
        <marker id="arrow-pf" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#FF6B1C" />
        </marker>
      </defs>

      {pipeline.map((step, i) => {
        const x = 10 + i * 88;
        return (
          <g class="pipeline-step" data-step={i} style="cursor: pointer;">
            <rect x={x} y="40" width="78" height="80" rx="8" fill="#FFFFFF" stroke={step.color} stroke-width="1.5" opacity="0.7" class="step-rect" />
            <text x={x + 39} y="70" text-anchor="middle" fill={step.color} font-family="JetBrains Mono, monospace" font-size="10" font-weight="600">{step.label}</text>
            {step.sublabel && (
              <text x={x + 39} y="88" text-anchor="middle" fill="#A8A29E" font-family="JetBrains Mono, monospace" font-size="7">{step.sublabel}</text>
            )}
            {i < pipeline.length - 1 && (
              <line x1={x + 78} y1="80" x2={x + 88} y2="80" stroke="#D6D3D1" stroke-width="1.5" marker-end="url(#arrow-pf)" class="pipeline-arrow" />
            )}
          </g>
        );
      })}

      <!-- Animated flow dot -->
      <circle r="3" fill="#FF6B1C" opacity="0.8" class="flow-dot">
        <animateMotion dur="3s" repeatCount="indefinite" path="M10,80 L710,80" />
      </circle>
    </svg>
  </div>

  <!-- Mobile fallback -->
  <div class="md:hidden mt-4 space-y-2 px-4">
    <p class="font-mono text-xs text-text-muted mb-2">Request pipeline:</p>
    <div class="flex flex-wrap gap-2">
      {pipeline.map((step) => (
        <span class="tech-badge text-xs" style={`border-color: ${step.color}40; color: ${step.color};`}>
          {step.label}
        </span>
      ))}
    </div>
  </div>
</div>

<script>
  function initPathFinderDiagram() {
    const diagram = document.querySelector('[data-component="pathfinder"]');
    if (!diagram) return;

    const steps = diagram.querySelectorAll('.pipeline-step');
    const rects = diagram.querySelectorAll('.step-rect');
    const arrows = diagram.querySelectorAll('.pipeline-arrow');

    steps.forEach((step, i) => {
      step.addEventListener('mouseenter', () => {
        // Highlight current and all previous steps
        rects.forEach((rect, j) => {
          const el = rect as SVGRectElement;
          if (j <= i) {
            el.setAttribute('opacity', '1');
            el.setAttribute('stroke-width', '2.5');
          } else {
            el.setAttribute('opacity', '0.3');
          }
        });
        arrows.forEach((arrow, j) => {
          const el = arrow as SVGLineElement;
          if (j < i) {
            el.setAttribute('stroke', '#FF6B1C');
            el.setAttribute('stroke-width', '2');
          } else {
            el.setAttribute('stroke', '#D6D3D1');
            el.setAttribute('stroke-width', '1.5');
          }
        });
      });

      step.addEventListener('mouseleave', () => {
        rects.forEach((rect) => {
          const el = rect as SVGRectElement;
          el.setAttribute('opacity', '0.7');
          el.setAttribute('stroke-width', '1.5');
        });
        arrows.forEach((arrow) => {
          const el = arrow as SVGLineElement;
          el.setAttribute('stroke', '#D6D3D1');
          el.setAttribute('stroke-width', '1.5');
        });
      });

      step.addEventListener('touchstart', (e) => {
        e.preventDefault();
        rects.forEach((rect, j) => {
          const el = rect as SVGRectElement;
          if (j <= i) {
            el.setAttribute('opacity', '1');
            el.setAttribute('stroke-width', '2.5');
          } else {
            el.setAttribute('opacity', '0.3');
          }
        });
        arrows.forEach((arrow, j) => {
          const el = arrow as SVGLineElement;
          if (j < i) {
            el.setAttribute('stroke', '#FF6B1C');
            el.setAttribute('stroke-width', '2');
          } else {
            el.setAttribute('stroke', '#D6D3D1');
            el.setAttribute('stroke-width', '1.5');
          }
        });
        // Reset after 2s on touch
        setTimeout(() => {
          rects.forEach((rect) => {
            const el = rect as SVGRectElement;
            el.setAttribute('opacity', '0.7');
            el.setAttribute('stroke-width', '1.5');
          });
          arrows.forEach((arrow) => {
            const el = arrow as SVGLineElement;
            el.setAttribute('stroke', '#D6D3D1');
            el.setAttribute('stroke-width', '1.5');
          });
        }, 2000);
      }, { passive: false });
    });
  }

  document.addEventListener('astro:page-load', initPathFinderDiagram);
  initPathFinderDiagram();
</script>

<style>
  .pipeline-step {
    transition: opacity 0.2s ease;
  }
  .step-rect {
    transition: all 0.2s ease;
  }
</style>
