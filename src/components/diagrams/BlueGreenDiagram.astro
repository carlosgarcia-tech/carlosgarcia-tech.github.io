---
/**
 * BlueGreenDiagram — interactive Blue/Green deployment.
 * Nginx routes traffic to one slot; "Deploy" spins up the new version in the
 * inactive slot, runs a health check, and switches over. "Rollback" goes back.
 */
---

<div class="bg-diagram card-surface p-6 md:p-8" data-component="bluegreen">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
      <h3 class="font-heading font-semibold text-text-primary">
        Blue/Green deployment
      </h3>
      <p
        class="text-text-muted text-xs font-mono mt-1"
        data-bg-status
        aria-live="polite"
      >
        Status: v1 serving traffic
      </p>
    </div>
    <div class="flex gap-2">
      <button type="button" data-bg-deploy class="bg-btn bg-btn-primary"
        >▶ Deploy v2</button
      >
      <button type="button" data-bg-rollback class="bg-btn" disabled
        >↺ Rollback</button
      >
    </div>
  </div>

  <svg
    viewBox="0 0 600 220"
    class="w-full h-auto"
    role="img"
    aria-label="Blue/Green diagram: Nginx routes traffic to the blue or green slot"
  >
    <!-- Client -->
    <g>
      <rect x="10" y="85" width="80" height="50" rx="8" class="bg-box"></rect>
      <text x="50" y="115" text-anchor="middle" class="bg-text">Clients</text>
    </g>
    <!-- Nginx -->
    <g>
      <rect x="170" y="85" width="90" height="50" rx="8" class="bg-box"></rect>
      <text x="215" y="115" text-anchor="middle" class="bg-text">Nginx</text>
    </g>
    <!-- Slots -->
    <g class="bg-slot" data-slot="blue">
      <rect
        x="400"
        y="20"
        width="170"
        height="70"
        rx="10"
        class="bg-slot-box bg-blue"></rect>
      <text x="485" y="46" text-anchor="middle" class="bg-text bg-title"
        >BLUE</text
      >
      <text
        x="485"
        y="68"
        text-anchor="middle"
        class="bg-text-sm"
        data-slot-ver="blue">v1 · active</text
      >
    </g>
    <g class="bg-slot" data-slot="green">
      <rect
        x="400"
        y="130"
        width="170"
        height="70"
        rx="10"
        class="bg-slot-box bg-green"></rect>
      <text x="485" y="156" text-anchor="middle" class="bg-text bg-title"
        >GREEN</text
      >
      <text
        x="485"
        y="178"
        text-anchor="middle"
        class="bg-text-sm"
        data-slot-ver="green">inactive</text
      >
    </g>

    <!-- Routes -->
    <line x1="90" y1="110" x2="170" y2="110" class="bg-route bg-route-on"
    ></line>
    <path
      d="M260 110 C 330 110, 330 55, 400 55"
      class="bg-route bg-route-on"
      data-route="blue"></path>
    <path
      d="M260 110 C 330 110, 330 165, 400 165"
      class="bg-route"
      data-route="green"></path>

    <!-- Traffic particles -->
    <circle r="3.5" class="bg-packet" data-packet="in">
      <animateMotion dur="1.2s" repeatCount="indefinite" path="M90 110 L170 110"
      ></animateMotion>
    </circle>
    <circle r="3.5" class="bg-packet" data-packet="blue">
      <animateMotion
        dur="1.2s"
        repeatCount="indefinite"
        path="M260 110 C 330 110, 330 55, 400 55"></animateMotion>
    </circle>
    <circle r="3.5" class="bg-packet bg-packet-off" data-packet="green">
      <animateMotion
        dur="1.2s"
        repeatCount="indefinite"
        path="M260 110 C 330 110, 330 165, 400 165"></animateMotion>
    </circle>
  </svg>

  <ol
    class="bg-steps mt-4 grid grid-cols-2 md:grid-cols-4 gap-2 font-mono text-xs"
    data-bg-steps
  >
    <li>1 · Build image</li>
    <li>2 · Spin up inactive slot</li>
    <li>3 · Health check</li>
    <li>4 · Switch Nginx</li>
  </ol>
</div>

<script>
  function initBlueGreen() {
    document
      .querySelectorAll<HTMLElement>('[data-component="bluegreen"]')
      .forEach((root) => {
        if (root.dataset.ready) return;
        root.dataset.ready = "true";

        const statusEl = root.querySelector<HTMLElement>("[data-bg-status]")!;
        const deployBtn =
          root.querySelector<HTMLButtonElement>("[data-bg-deploy]")!;
        const rollbackBtn =
          root.querySelector<HTMLButtonElement>("[data-bg-rollback]")!;
        const steps = Array.from(
          root.querySelectorAll<HTMLElement>("[data-bg-steps] li"),
        );
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        const delay = reduce ? 200 : 1000;

        type Slot = "blue" | "green";
        let active: Slot = "blue";
        let version = 1;
        let busy = false;

        const q = <T extends Element>(sel: string) =>
          root.querySelector<T>(sel)!;
        const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
        const other = (s: Slot): Slot => (s === "blue" ? "green" : "blue");

        function setStep(n: number) {
          steps.forEach((li, i) => {
            li.classList.toggle("is-done", i < n);
            li.classList.toggle("is-current", i === n);
          });
        }

        function render(opts?: { warming?: Slot }) {
          (["blue", "green"] as Slot[]).forEach((s) => {
            const isActive = s === active;
            q(`[data-slot="${s}"]`).classList.toggle("is-active", isActive);
            q(`[data-slot="${s}"]`).classList.toggle(
              "is-warming",
              opts?.warming === s,
            );
            q(`[data-route="${s}"]`).classList.toggle("bg-route-on", isActive);
            q(`[data-packet="${s}"]`).classList.toggle(
              "bg-packet-off",
              !isActive,
            );
          });
        }

        function setVer(slot: Slot, text: string) {
          q(`[data-slot-ver="${slot}"]`).textContent = text;
        }

        async function deploy() {
          if (busy) return;
          busy = true;
          deployBtn.disabled = rollbackBtn.disabled = true;
          const target = other(active);
          const next = version + 1;

          setStep(0);
          statusEl.textContent = `Building image v${next}…`;
          await sleep(delay);

          setStep(1);
          statusEl.textContent = `Spinning up v${next} in ${target.toUpperCase()} (no traffic)…`;
          setVer(target, `v${next} · starting`);
          render({ warming: target });
          await sleep(delay);

          setStep(2);
          statusEl.textContent = `Health check on ${target.toUpperCase()}…`;
          setVer(target, `v${next} · health check`);
          await sleep(delay);

          setStep(3);
          statusEl.textContent = "Switching Nginx — zero downtime";
          const previous = active;
          active = target;
          version = next;
          setVer(target, `v${next} · active`);
          setVer(previous, `v${next - 1} · standby`);
          render();
          await sleep(delay);

          setStep(4);
          statusEl.textContent = `v${next} serving traffic. v${next - 1} ready for rollback.`;
          busy = false;
          deployBtn.disabled = false;
          rollbackBtn.disabled = false;
          deployBtn.textContent = `▶ Deploy v${version + 1}`;
        }

        async function rollback() {
          if (busy) return;
          busy = true;
          deployBtn.disabled = rollbackBtn.disabled = true;
          const previous = other(active);
          statusEl.textContent =
            "Rollback: switching Nginx to the previous slot…";
          const failed = version;
          active = previous;
          version = version - 1;
          setVer(previous, `v${version} · active`);
          setVer(other(previous), `v${failed} · reverted`);
          render();
          setStep(3);
          await sleep(delay);
          statusEl.textContent = `Rollback complete: v${version} serving traffic (instant).`;
          busy = false;
          deployBtn.disabled = false;
          rollbackBtn.disabled = true;
          deployBtn.textContent = `▶ Deploy v${version + 1}`;
        }

        deployBtn.addEventListener("click", deploy);
        rollbackBtn.addEventListener("click", rollback);
        render();
      });
  }

  document.addEventListener("astro:page-load", initBlueGreen);
  initBlueGreen();
</script>

<style>
  .bg-box {
    fill: #fff;
    stroke: #d6d3d1;
    stroke-width: 2;
  }
  .bg-text {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    fill: #27272a;
  }
  .bg-title {
    font-size: 13px;
  }
  .bg-text-sm {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    fill: #57534e;
  }
  .bg-slot-box {
    fill: #fff;
    stroke-width: 2;
    opacity: 0.55;
    transition: all 0.4s ease;
  }
  .bg-blue {
    stroke: #3b82f6;
  }
  .bg-green {
    stroke: #15803d;
  }
  .bg-slot.is-active .bg-slot-box {
    opacity: 1;
    stroke-width: 4;
  }
  .bg-slot.is-warming .bg-slot-box {
    opacity: 0.9;
    stroke-dasharray: 6 4;
    animation: bg-pulse 0.9s ease-in-out infinite alternate;
  }
  @keyframes bg-pulse {
    to {
      opacity: 0.5;
    }
  }
  .bg-route {
    fill: none;
    stroke: #d6d3d1;
    stroke-width: 2;
    transition: stroke 0.4s ease;
  }
  .bg-route-on {
    stroke: #ff6b1c;
  }
  .bg-packet {
    fill: #ff6b1c;
    transition: opacity 0.3s ease;
  }
  .bg-packet-off {
    opacity: 0;
  }
  .bg-btn {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid #d6d3d1;
    color: #57534e;
    transition: all 0.15s ease;
  }
  .bg-btn:hover:not(:disabled) {
    border-color: #ff6b1c;
    color: #ff6b1c;
  }
  .bg-btn-primary {
    background: #ff6b1c;
    border-color: #ff6b1c;
    color: #fff;
  }
  .bg-btn-primary:hover:not(:disabled) {
    background: #ea580c;
    color: #fff;
  }
  .bg-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .bg-steps li {
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid #e7e5e4;
    color: #78716c;
    transition: all 0.3s ease;
  }
  .bg-steps li.is-current {
    border-color: #ff6b1c;
    color: #ea580c;
  }
  .bg-steps li.is-done {
    background: rgb(255 107 28 / 0.08);
    border-color: #ff6b1c;
    color: #ea580c;
  }
  @media (prefers-reduced-motion: reduce) {
    .bg-slot.is-warming .bg-slot-box {
      animation: none;
    }
    .bg-slot-box,
    .bg-route,
    .bg-steps li {
      transition: none;
    }
  }
</style>
